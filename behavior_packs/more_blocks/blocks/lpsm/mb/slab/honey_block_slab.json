{
  "format_version": "1.26.10",
  "minecraft:block": {
    "description": {
      "identifier": "lpsm_mb:honey_block_slab",
      "traits": {
        "minecraft:placement_position": {
          "enabled_states": ["minecraft:vertical_half"]
        }
      },
      "states": {
        "lpsm_mb:double": [false, true]
      },
      "menu_category": {
        "category": "construction",
        "group": "minecraft:itemGroup.name.slab"
      }
    },
    "components": {
      "minecraft:friction": 0.1,
      "minecraft:light_dampening": 0,
      "minecraft:liquid_detection": {
        "detection_rules": [
          {
            "can_contain_liquid": true,
            "liquid_type": "water",
            "stops_liquid_flowing_from_direction": ["down"]
          }
        ]
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 2
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 2
      },
      "minecraft:material_instances": {
        "*": {
          "texture": "minecraft:honey_side",
          "render_method": "blend"
        },
        "up": {
          "texture": "minecraft:honey_top",
          "render_method": "blend"
        },
        "down": {
          "texture": "minecraft:honey_bottom",
          "render_method": "blend"
        }
      },
      "minecraft:geometry": {
        "identifier": "geometry.lpsm_mb.honey_slab",
        "bone_visibility": {
          "top": "q.block_state('minecraft:vertical_half')=='top'",
          "bottom": "q.block_state('minecraft:vertical_half')=='bottom'"
        },
        "culling": "lpsm_assetsplus:slab"
      },
      "lpsm_mb:slab": {
        "double_state": "lpsm_mb:double"
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('lpsm_mb:double')",
        "components": {
          "minecraft:loot": "loot_tables/lpsm/mb/blocks/honey_block_double_slab.json",
          "minecraft:geometry": "geometry.lpsm_assetsplus.honey_block",
          "minecraft:liquid_detection": {
            "detection_rules": [
              {
                "can_contain_liquid": false,
                "liquid_type": "water"
              }
            ]
          },
          "minecraft:selection_box": {
            "origin": [-7, 0, -7],
            "size": [14, 16, 14]
          },
          "minecraft:collision_box": {
            "origin": [-7, 0, -7],
            "size": [14, 16, 14]
          }
        }
      },
      {
        "condition": "!q.block_state('lpsm_mb:double')&&q.block_state('minecraft:vertical_half')=='top'",
        "components": {
          "minecraft:collision_box": {
            "origin": [-7, 8, -7],
            "size": [14, 8, 14]
          },
          "minecraft:selection_box": {
            "origin": [-7, 8, -7],
            "size": [14, 8, 14]
          },
          "minecraft:liquid_detection": {
            "detection_rules": [
              {
                "can_contain_liquid": true,
                "liquid_type": "water",
                "stops_liquid_flowing_from_direction": ["up"]
              }
            ]
          }
        }
      },
      {
        "condition": "!q.block_state('lpsm_mb:double')&&q.block_state('minecraft:vertical_half')=='bottom'",
        "components": {
          "minecraft:collision_box": {
            "origin": [-7, 0, -7],
            "size": [14, 8, 14]
          },
          "minecraft:selection_box": {
            "origin": [-7, 0, -7],
            "size": [14, 8, 14]
          }
        }
      }
    ]
  }
}
