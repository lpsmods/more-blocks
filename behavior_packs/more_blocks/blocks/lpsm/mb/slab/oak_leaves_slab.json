{
  "format_version": "1.26.10",
  "minecraft:block": {
    "description": {
      "identifier": "lpsm_mb:oak_leaves_slab",
      "traits": {
        "minecraft:placement_position": {
          "enabled_states": ["minecraft:vertical_half"]
        }
      },
      "states": {
        "lpsm_mb:persistent": [true, false],
        "lpsm_mb:double": [false, true]
      },
      "menu_category": {
        "category": "construction",
        "group": "minecraft:itemGroup.name.slab"
      }
    },
    "components": {
      "minecraft:light_dampening": 0,
      "minecraft:liquid_detection": {
        "detection_rules": [
          {
            "can_contain_liquid": true,
            "liquid_type": "water"
          }
        ]
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0.2
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 0.2
      },
      "minecraft:material_instances": {
        "*": {
          "texture": "minecraft:oak_leaves",
          "render_method": "alpha_test_single_sided",
          "tint_method": "default_foliage"
        }
      },
      "minecraft:geometry": {
        "identifier": "geometry.lpsm_assetsplus_slab",
        "bone_visibility": {
          "top": "q.block_state('minecraft:vertical_half')=='top'",
          "bottom": "q.block_state('minecraft:vertical_half')=='bottom'"
        },
        "culling": "lpsm_assetsplus:slab"
      },
      "lpsm_mb:slab": {
        "double_state": "lpsm_mb:double"
      },
      "minecraft:flammable": {}
    },
    "permutations": [
      {
        "condition": "q.block_state('lpsm_mb:double')",
        "components": {
          "minecraft:loot": "loot_tables/lpsm/mb/blocks/oak_leaves_double_slab.json",
          "minecraft:geometry": "minecraft:geometry.full_block",
          "minecraft:selection_box": true,
          "minecraft:collision_box": true
        }
      },
      {
        "condition": "!q.block_state('lpsm_mb:double')&&q.block_state('minecraft:vertical_half')=='top'",
        "components": {
          "minecraft:collision_box": {
            "origin": [-8, 8, -8],
            "size": [16, 8, 16]
          },
          "minecraft:selection_box": {
            "origin": [-8, 8, -8],
            "size": [16, 8, 16]
          }
        }
      },
      {
        "condition": "!q.block_state('lpsm_mb:double')&&q.block_state('minecraft:vertical_half')=='bottom'",
        "components": {
          "minecraft:collision_box": {
            "origin": [-8, 0, -8],
            "size": [16, 8, 16]
          },
          "minecraft:selection_box": {
            "origin": [-8, 0, -8],
            "size": [16, 8, 16]
          }
        }
      }
    ]
  }
}
