{
  "format_version": "1.26.10",
  "minecraft:block": {
    "description": {
      "identifier": "lpsm_mb:redstone_lamp_slab",
      "traits": {
        "minecraft:placement_position": {
          "enabled_states": ["minecraft:vertical_half"]
        }
      },
      "states": {
        "lpsm_mb:double": [false, true],
        "lpsm_mb:lit": [false, true]
      },
      "menu_category": {
        "category": "construction",
        "group": "minecraft:itemGroup.name.slab"
      }
    },
    "components": {
      "minecraft:light_dampening": 0,
      "minecraft:liquid_detection": {
        "detection_rules": [
          {
            "can_contain_liquid": true,
            "liquid_type": "water",
            "stops_liquid_flowing_from_direction": ["down"]
          }
        ]
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 0.3
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 0.3
      },
      "minecraft:geometry": {
        "identifier": "geometry.lpsm_assetsplus_slab",
        "bone_visibility": {
          "top": "q.block_state('minecraft:vertical_half')=='top'",
          "bottom": "q.block_state('minecraft:vertical_half')=='bottom'"
        },
        "culling": "lpsm_assetsplus:slab"
      },
      "minecraft:material_instances": {
        "*": {
          "texture": "minecraft:redstone_lamp_off"
        }
      },
      "minecraft:redstone_consumer": {
        "min_power": 0
      },
      "lpsm_mb:slab": {
        "double_state": "lpsm_mb:double"
      },
      "lpsm_mb:redstone_lamp": {
        "lit_state": "lpsm_mb:lit"
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('lpsm_mb:double')",
        "components": {
          "minecraft:loot": "loot_tables/lpsm/mb/blocks/redstone_lamp_double_slab.json",
          "minecraft:collision_box": true,
          "minecraft:selection_box": true,
          "minecraft:geometry": "minecraft:geometry.full_block"
        }
      },
      {
        "condition": "!q.block_state('lpsm_mb:double')&&q.block_state('minecraft:vertical_half')=='top'",
        "components": {
          "minecraft:collision_box": {
            "origin": [-8, 8, -8],
            "size": [16, 8, 16]
          },
          "minecraft:selection_box": {
            "origin": [-8, 8, -8],
            "size": [16, 8, 16]
          },
          "minecraft:liquid_detection": {
            "detection_rules": [
              {
                "can_contain_liquid": true,
                "liquid_type": "water",
                "stops_liquid_flowing_from_direction": ["up"]
              }
            ]
          }
        }
      },
      {
        "condition": "!q.block_state('lpsm_mb:double')&&q.block_state('minecraft:vertical_half')=='bottom'",
        "components": {
          "minecraft:collision_box": {
            "origin": [-8, 0, -8],
            "size": [16, 8, 16]
          },
          "minecraft:selection_box": {
            "origin": [-8, 0, -8],
            "size": [16, 8, 16]
          }
        }
      },
      {
        "condition": "q.block_state('lpsm_mb:lit')",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "minecraft:redstone_lamp_on"
            }
          },
          "minecraft:light_emission": 15
        }
      }
    ]
  }
}
